# Segredos / credenciais (ex.: futura integração com Google Sheets/Drive API)
.env
.env.*
*credentials*.json
*service-account*.json
client_secret*.json
token.json

# Planilhas de trabalho locais. A fonte de verdade é a planilha do Google Drive;
# a cópia local serve só como backup e referência, então não vai para o repositório.
*.xlsx
*.privado.csv

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDEs
.vscode/
.idea/
*.swp

# Logs e temporários
*.log
*.tmp
~$*

# Node (caso alguma ferramenta de build seja adicionada futuramente)
node_modules/
dist/

# Pastas de deploy rápido/temporário (ex.: Netlify Drop) — cópia gerada, não é fonte
deploy-netlify-drop/
